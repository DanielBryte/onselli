# Onselli local development
# Copy to .env.local. Never commit .env.local or paste real secrets into chat.

# Required to run the app
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/onselli?sslmode=require
# Optional pooled/unpooled connection for Drizzle CLI and migrations; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/onselli?sslmode=require
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters

# Account email: email verification and password reset depend on this in local testing.
# Google sign-in is enabled only when both Google OAuth values are set.
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_SEND_API_KEY=
ZEPTOMAIL_FROM_EMAIL=verified-sender@example.com
ZEPTOMAIL_FROM_NAME=Onselli
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bachs hosted checkout and verified webhook testing (sandbox only).
# Get the sandbox API key, webhook signing secret, and Onselli platform account ID from Bachs.
BACHS_ENV=sandbox
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_PLATFORM_ACCOUNT_ID=
# Keep these disabled for local/sandbox testing. Do not switch to live without approvals and operations.
PAYMENTS_LIVE_ENABLED=false
BACHS_PLATFORM_READY=false

# Product payment/payout policy. Keep payout execution blocked until Finance confirms the values.
ONSELLI_PLATFORM_FEE_BPS=500
BACHS_PAYOUT_FEE_MINOR_BY_ROUTE={}
BACHS_CREATOR_RISK_POLICY_VERSION=
BACHS_CREATOR_RESERVE_BPS=
BACHS_CREATOR_RESERVE_HOLD_DAYS=

# Private paid files and public workspace logos use separate R2 buckets.
# Required for file uploads/downloads and logo uploads; never make the private bucket public.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=onselli-digital-products
R2_PUBLIC_BUCKET_NAME=onselli-public-assets
R2_PUBLIC_BASE_URL=https://assets.example.com

# Required before storing bank account details for payout settings.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BANK_DATA_ENCRYPTION_KEY=

# Hosted course video (Bunny Stream). Upload/playback fail closed until all values are configured
# and Embed View Token Authentication is enabled in the Bunny library.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_AUTH_KEY=
BUNNY_STREAM_EMBED_TOKEN_AUTH_ENABLED=false

# Public API rate limiting. Optional in development; required for production public endpoints.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Durable workflows (campaign dispatch and form notifications).
# Local: QSTASH_DEV=true uses the local development mode and does not require QStash credentials.
# Production: set QSTASH_DEV=false and provide the token and both signing keys.
QSTASH_DEV=true
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Bot protection. Local dev can omit these; configure both keys in production.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: creator marketing campaigns via Amazon SES (separate from transactional ZeptoMail).
# Required for campaigns: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION, SES_FROM_EMAIL.
# AWS_SESSION_TOKEN is only needed for temporary AWS credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=eu-west-1
SES_FROM_EMAIL=campaigns@example.com
# Optional SES configuration set and signed webhook secret for SES event callbacks.
SES_CONFIGURATION_SET=
SES_WEBHOOK_SECRET=

# Optional product plan billing. Leave disabled unless Bachs recurring USD products/webhooks are configured.
SUBSCRIPTIONS_ENABLED=false
BACHS_PLAN_PRO_USD_PRODUCT_ID=
BACHS_PLAN_STUDIO_USD_PRODUCT_ID=
BACHS_PLAN_PRO_USD_YEARLY_PRODUCT_ID=
BACHS_PLAN_STUDIO_USD_YEARLY_PRODUCT_ID=

# Optional error monitoring.
SENTRY_DSN=
